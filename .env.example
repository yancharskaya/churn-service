# Скопировать в .env и поправить под себя: cp .env.example .env
# Имена переменных = поля класса Settings в верхнем регистре.

# --- MLflow ---
# ПУСТО = локальный режим (model.pkl рядом, без MLflow и MinIO)
# Раскомментируйте, когда поднят docker compose:
# MLFLOW_TRACKING_URI=http://localhost:5000

MLFLOW_EXPERIMENT_NAME=churn
MODEL_NAME=churn-model
MODEL_ALIAS=champion

# --- MinIO / S3 ---
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=admin123

# --- данные и отчёты ---
DATA_PATH=data/train.csv
MODEL_PATH=model.pkl        # используется только в локальном режиме

REPORTS_DIR=reports

# --- прочее ---
LOG_LEVEL=INFO
